name                   = "stablerail-cex"
environment            = "development"
aws_region             = "us-west-2"
grafana_admin_user_ids = ["replace-with-identity-center-user-id"]
vpc_cidr               = "10.80.0.0/16"

# EKS is the home for Order, Ledger, and Matching. Supply a dedicated
# operator IAM role ARN before applying; the Kubernetes API is private unless
# narrow operator CIDRs are explicitly listed.
eks_version             = "1.35"
eks_admin_principal_arn = "arn:aws:iam::123456789012:role/replace-with-dedicated-eks-operator-role"
eks_public_access_cidrs = []
eks_node_instance_types = ["m6i.xlarge"]
eks_node_min_size       = 6
eks_node_max_size       = 12

availability_zone_count = 3
nat_gateway_per_az      = true
# Supply an issued ACM certificate in this region for the public Order ALB.
order_alb_certificate_arn = "arn:aws:acm:us-west-2:123456789012:certificate/replace-me"

# Verify the desired engine version and instance-class availability in the
# selected region. Leave the version null to let AWS choose its current default.
postgres_engine_version       = null
postgres_instance_class       = "db.r6gd.xlarge"
postgres_allocated_storage_gib = 500
postgres_iops                  = 10000
postgres_backup_retention_days = 14
postgres_deletion_protection   = true
postgres_skip_final_snapshot   = false

# Repositories use immutable tags and scan every pushed image. Keep enough
# tagged images for deployment rollback while pruning build leftovers.
ecr_tagged_image_retention_count = 50
ecr_untagged_retention_days       = 7

# Enhanced Container Insights supplies task- and container-level telemetry.
ecs_container_insights_mode = "enhanced"
ecs_log_retention_days       = 30

# Set after building and pushing the matching-engine image to ECR. This mock
# remains single-replica and is not production matching.
matching_image_digest = null

# Create distinct Ledger and Outbox runtime password secrets first, and set
# their ARNs before the Outbox migration task. Only migration jobs/tasks use
# the RDS admin password. Run the Ledger migration Job before Outbox migration.
ledger_migration_image_digest = null
ledger_image_digest           = null
ledger_runtime_secret_arn     = ""

# Alarm when Ledger falls this many records behind ledger.commands.v1.
ledger_consumer_max_offset_lag = 1000

# Outbox migration also creates the restricted runtime roles; then deploy the relay.
outbox_migration_image_digest = null
outbox_image_digest           = null
outbox_runtime_secret_arn     = ""

# Set only after Ledger and Matching images are configured and healthy.
# Order remains private until an authenticated Kubernetes ingress is added.
order_image_digest = null

# Pin a reviewed ADOT image for the shared EKS metrics/traces collector before
# the final infra/k8s apply. The initial migration-only apply does not need it.
eks_collector_image = null

# Optional tracing for the ECS Outbox Relay. Its separate sidecar sends sampled
# traces to X-Ray and metrics to the same AMP workspace. This sampling ratio
# also applies to Order, Ledger, and Matching on EKS.
trace_collector_image = null
trace_sample_ratio    = 0.1

# AMP workspace is always provisioned. The EKS collector scrapes the hot-path
# pods and remote-writes to it; the optional ECS sidecar writes there too.
managed_metrics_retention_days = 30

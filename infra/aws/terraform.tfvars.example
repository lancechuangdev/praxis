name        = "stablerail-cex"
environment = "development"
aws_region  = "us-west-2"
vpc_cidr    = "10.80.0.0/16"

availability_zone_count = 3
nat_gateway_per_az      = true

# Verify the desired engine version and instance-class availability in the
# selected region. Leave the version null to let AWS choose its current default.
postgres_engine_version       = null
postgres_instance_class       = "db.r6gd.xlarge"
postgres_allocated_storage_gib = 500
postgres_iops                  = 10000
postgres_backup_retention_days = 14
postgres_deletion_protection   = true
postgres_skip_final_snapshot   = false

# Repositories use immutable tags and scan every pushed image. Keep enough
# tagged images for deployment rollback while pruning build leftovers.
ecr_tagged_image_retention_count = 50
ecr_untagged_retention_days       = 7

# Enhanced Container Insights supplies task- and container-level telemetry.
ecs_container_insights_mode = "enhanced"
ecs_log_retention_days       = 30

# Keep the public ALB disabled until edge authentication and the Order ECS
# service are ready. Enabling it requires an ACM certificate in this Region.
order_alb_enabled             = false
order_alb_certificate_arn     = null
order_alb_deletion_protection = false

# Set only after building and pushing the matching-engine image to its ECR
# repository. This mock remains single-replica and is not production matching.
matching_image_digest = null

# First register and run the one-off migration task, then set the same digest
# for the long-running service. Both tasks currently use the RDS admin password.
ledger_migration_image_digest = null
ledger_image_digest           = null

# Run Ledger migrations before Outbox migrations, then deploy the relay.
outbox_migration_image_digest = null
outbox_image_digest           = null

# Set only after Ledger and Matching images are configured and healthy.
# Order remains private and the public ALB still returns 503.
order_image_digest = null

# Optional existing SNS topic for ECS no-running-tasks alarm notifications.
# The topic must permit CloudWatch alarms to publish and have confirmed subscribers.
ecs_alarm_sns_topic_arn = null
